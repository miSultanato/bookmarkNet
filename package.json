{
  "name": "bookmarknet",
  "version": "0.0.0",
  "description": "Red P2P de bookmarks. El activo principal es el enlace, no el usuario.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "generate:assets": "node scripts/generate-assets.js",
